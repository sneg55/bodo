# Copy to .env.local for `next dev`, and to .dev.vars for `wrangler`/`opennextjs-cloudflare preview`.
# In production these are Worker vars and secrets, not a file: see the checklist at
# the bottom of wrangler.jsonc.
# Storage is bindings, not URLs: see wrangler.jsonc for R2/KV/DO. Only plain vars belong here.

# --- Which deployment this is ---
# local | preview | production. Decides how strict the env schema is, and it is
# DEPLOY_ENV rather than NODE_ENV because `next build` and `cf:preview` both run
# with NODE_ENV=production, so gating on that would make a local preview demand
# real production secrets. At `production` every value marked (prod) below becomes
# mandatory and a deploy missing one fails on its first request.
DEPLOY_ENV=local

# --- Runtime (prod) ---
# The origin this deployment serves from. Used to build magic links, portal links,
# and .ics URLs. No default on purpose: a localhost fallback does not fail loudly,
# it silently emails localhost links.
APP_URL=http://localhost:3000

# --- Airtable (source of truth) (prod) ---
# A personal access token, NOT a legacy API key: those are retired. Scope it
# data.records:read, data.records:write, schema.bases:read (plus schema.bases:write
# for the schema script) and grant it access to the one base.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=

# --- Sessions (prod) ---
# 32+ random bytes. Generate: openssl rand -hex 32
SESSION_SECRET=

# --- Email (prod) (see BUILD_SPEC section 7.3 for why Resend and not Cloudflare) ---
# EMAIL_FROM must be on a domain verified in Resend. The resend.dev test domain
# only delivers to the Resend account owner's own address, so it cannot send to
# speakers, reviewers, or a calendar client: with magic-link auth that means
# nobody but you can log in.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=

# The other implemented provider, and the one that makes the mailbox side testable:
# AgentMail hands out a real inbox from an API call and lets you read it back, so an
# emailed magic link or a .ics can be checked for real rather than asserted against a
# stub. Set EMAIL_PROVIDER=agentmail and point EMAIL_FROM at an address on an inbox this
# key owns, because AgentMail takes the sender from the inbox rather than from a header.
#
#   EMAIL_PROVIDER=agentmail
#   AGENTMAIL_API_KEY=
#   EMAIL_FROM=bodo CFP <you@agentmail.to>
AGENTMAIL_API_KEY=

# What domain the SEEDED identities get their addresses on, read by
# `npm run airtable:seed` (scripts/seed/scenario.ts). It defaults to example.com,
# which RFC 2606 reserves and which Resend refuses BY NAME: 422, "Please use our
# testing email address instead of domains like example.com". Since a magic link IS
# the login, that default means no seeded speaker can ever sign in and no
# notification can ever be delivered. Point it at a domain that accepts mail, with
# catch-all routing, before seeding a base anyone is going to demo from, and keep the
# three DEMO_* addresses below on the same domain.
#
# Only `next dev` and the node scripts read this file. `cf:preview` reads .dev.vars,
# and the seed scripts read .env.local or .env, so a value set in only one of them
# leaves the other half of the app looking for rows that do not exist.
SEED_EMAIL_DOMAIN=

# --- Files (prod) ---
# Custom domain serving public reads from the BODO_UPLOADS R2 bucket
R2_PUBLIC_BASE_URL=

# --- Speaker portal ---
# Which event the portal serves. The portal URLs carry no event id (/portal,
# /portal/submissions, ...) and BUILD_SPEC 5.6 settles on one portal per event, so
# the scope comes from here. Leave it blank with no Airtable base and the fixture
# event is used, which is what makes a fresh clone demo. Once AIRTABLE_BASE_ID is
# set this becomes required: the portal refuses to guess which event it is showing.
PORTAL_EVENT_ID=

# --- Accelevents one-way sync ---
# Leave ACCELEVENTS_MOCK=1 until a real test event and key exist: the mock logs
# payloads to SyncLog so the whole flow stays demoable. Setting it to 0 makes
# ACCELEVENTS_API_KEY mandatory, so the flag and the key cannot drift apart.
ACCELEVENTS_MOCK=1
ACCELEVENTS_API_KEY=

# --- Cron (prod) ---
# Shared secret the scheduled handler and the admin "run now" button both present
# to /api/cron/*. Without it those routes are open to anyone.
CRON_SECRET=

# --- Demo mode ---
# Puts three "Continue as ..." buttons on /login that sign in with no mailbox in the
# loop. Meant for a public demo, where a visitor has no address on this deployment,
# and for local debugging, where the alternative is reading a sign-in link out of the
# server log. On here because a fresh clone should be able to sign in immediately; a
# deployment stays shut until someone sets it, and setting it at DEPLOY_ENV=production
# is what makes RESEND_API_KEY and EMAIL_FROM optional there.
#
# TREAT IT AS A PUBLIC DOOR. Anyone who reaches /login can press the buttons, so only
# turn it on where the data is meant to be seen and edited by whoever visits.
#
# It grants exactly the three identities below and no others: each is resolved through
# the same lookup a magic link uses, so an address with no AdminUsers or Speakers row
# signs nobody in. The defaults are the fixture identities, which is what makes a
# clone with an empty AIRTABLE_TOKEN work with nothing else set.
DEMO_MODE=1
DEMO_ADMIN_EMAIL=organizer@example.com
DEMO_REVIEWER_EMAIL=reviewer1@example.com
DEMO_SPEAKER_EMAIL=ada@example.com

# --- AI surfaces (⌘K ask, review pre-screen, dashboard proposal) ---
# Same pairing as Accelevents above, and the same reason. AI_MOCK=1 serves canned
# output computed from this event's real data, so a clone with an empty .env can
# demonstrate all three surfaces; every one of them labels what it shows as a sample.
#
# SETTING ANTHROPIC_API_KEY ALONE CHANGES NOTHING. The flag is what selects the live
# client, so going live is both lines: AI_MOCK=0 makes ANTHROPIC_API_KEY mandatory,
# which is what stops a deployment from promising a live model it has no key for.
AI_MOCK=1
ANTHROPIC_API_KEY=
